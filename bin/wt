#!/usr/bin/env bash
set -euo pipefail

VERSION="0.7.0"

WT_HOOKS_DIR="${WT_HOOKS_DIR:-$HOME/.config/wt/hooks}"

show_help() {
  cat <<EOF
Usage: wt <command> [args]

  <branch>              Create a worktree for <branch> (enters it if it exists)
  create <branch>       Same as the shorthand, with options below
  ls|list               List worktrees
  rm|remove [-f] <ref>  Remove a worktree by branch name or path
  done [-f|--force]     Remove the current worktree and return to main
  back                  Print the main worktree path

Options for create:
  -b, --base <branch>   Base branch for a new branch (defaults to current)
  -p, --path <path>     Custom worktree path
  --no-hook             Skip the post-create hook

  --version             Show version
  --help, -h            Show help

A single \$WT_HOOKS_DIR/post-create hook (default: ~/.config/wt/hooks) runs after
a worktree is created, if present and executable. It receives these env vars:
  WT_PATH WT_BRANCH WT_REPO_ROOT WT_REPO_NAME

Auto-cd (add to .bashrc/.zshrc): source the shipped wrapper, e.g.
  source "\$(brew --prefix)/share/wt/wt.sh"
EOF
}

# ---------- helpers ----------

# Outputs tab-separated <path>\t<branch> for every worktree, one per line.
# Detached worktrees are emitted as "(detached)". Paths may contain spaces, so
# we capture everything after the leading "worktree " keyword.
list_worktrees() {
  git worktree list --porcelain | awk '
    function flush() { if(w) print w "\t" (b ? b : "(detached)") }
    /^worktree /{ flush(); w=substr($0, 10); b="" }
    /^branch /{ gsub(/refs\/heads\//,"",$2); b=$2 }
    END{ flush() }
  '
}

# Path of the main working tree (git always lists it first).
main_worktree() {
  list_worktrees | awk -F'\t' 'NR==1{print $1; exit}'
}

# Path of the worktree checked out on <branch>, or empty. Parses the `branch`
# lines directly so it only ever matches a real branch. The branch value is
# passed via the environment rather than `awk -v` so a backslash in the name is
# not mangled by -v's C-escape processing.
worktree_for_branch() {
  local branch=$1
  git worktree list --porcelain | wt_b="$branch" awk '
    /^worktree /{ w=substr($0, 10) }
    /^branch /{ name=$0; sub(/^branch refs\/heads\//,"",name); if(name==ENVIRON["wt_b"]){print w; exit} }
  '
}

# Resolve <branch|path> to a worktree root. A branch name wins over a directory
# argument, which must itself be the root of a worktree.
resolve_worktree() {
  local input=$1 target
  target=$(worktree_for_branch "$input")
  if [[ -n "$target" ]]; then echo "$target"; return 0; fi

  if [[ -d "$input" ]]; then
    local phys wt rest
    phys=$(cd "$input" && pwd -P)
    while IFS=$'\t' read -r wt rest; do
      [[ "$phys" == "$(cd "$wt" 2>/dev/null && pwd -P)" ]] && { echo "$wt"; return 0; }
    done < <(list_worktrees)
  fi
  return 1
}

# ---------- hook ----------

run_post_create() {
  local wt_path=$1 branch=$2
  local hook="$WT_HOOKS_DIR/post-create"
  [[ -x "$hook" ]] || return 0
  echo "wt: running post-create hook" >&2
  local rc=0
  WT_PATH="$wt_path" \
  WT_BRANCH="$branch" \
  WT_REPO_ROOT="$repo_root" \
  WT_REPO_NAME="$repo_name" \
    "$hook" >&2 || rc=$?
  if [[ $rc -ne 0 ]]; then
    echo "wt: post-create hook failed (exit $rc); worktree exists at $wt_path" >&2
  fi
  return 0
}

# ---------- commands ----------

cmd_create() {
  local base="" path="" branch="" no_hook=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -b|--base) base=$2; shift 2 ;;
      -p|--path) path=$2; shift 2 ;;
      --no-hook) no_hook=true; shift ;;
      -h|--help) show_help; exit 0 ;;
      -*) echo "wt create: unknown option '$1'" >&2; exit 1 ;;
      *)
        if [[ -z "$branch" ]]; then branch=$1
        else echo "wt create: unexpected arg '$1' (use -p for a custom path)" >&2; exit 1; fi
        shift ;;
    esac
  done

  [[ -z "$branch" ]] && { echo "wt create: branch name required" >&2; exit 1; }

  # If the branch is already checked out in a worktree, enter it instead of
  # letting `git worktree add` fail with "already used by worktree at ...".
  local existing
  existing=$(worktree_for_branch "$branch")
  if [[ -n "$existing" ]]; then
    echo "wt: '$branch' already checked out at $existing, entering it" >&2
    echo "$existing"
    return 0
  fi

  # Worktrees sit beside the repo as <repo>.<branch>. The dot delimits repo from
  # branch unambiguously (a hyphen would collide with hyphens in either name);
  # slashes in the branch are slugified to hyphens for a valid path segment.
  : "${path:=$(dirname "$repo_root")/${repo_name}.${branch//\//-}}"

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add "$path" "$branch" >&2
  elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git worktree add --track -b "$branch" "$path" "origin/$branch" >&2
  else
    : "${base:=$(git branch --show-current)}"
    git worktree add -b "$branch" "$path" "$base" >&2
  fi

  [[ "$no_hook" == false ]] && run_post_create "$path" "$branch"

  echo "$path"
}

cmd_remove() {
  local force=false input=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force) force=true; shift ;;
      -h|--help) echo "Usage: wt rm [-f|--force] <branch|path>" >&2; exit 0 ;;
      *)
        if [[ -z "$input" ]]; then input=$1
        else echo "wt rm: unexpected arg '$1'" >&2; exit 1; fi
        shift ;;
    esac
  done
  [[ -z "$input" ]] && { echo "wt rm: provide a path or branch name" >&2; exit 1; }

  local target
  target=$(resolve_worktree "$input") || {
    echo "wt rm: unable to resolve worktree for '$input'" >&2
    exit 1
  }

  # If we're removing the worktree we're standing in, step out to main first so
  # the shell wrapper can relocate us out of the deleted directory.
  local return_to=""
  if [[ "$target" == "$repo_root" ]]; then
    return_to=$main_repo
    cd "$return_to"
  fi

  local args=()
  $force && args+=(--force)
  args+=("$target")
  git worktree remove "${args[@]}" >&2

  if [[ -n "$return_to" ]]; then
    echo "$return_to"
  fi
}

cmd_list() {
  git worktree list "$@"
}

cmd_back() {
  main_worktree
}

cmd_done() {
  local force=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force) force=true; shift ;;
      -h|--help) echo "Usage: wt done [-f|--force]" >&2; exit 0 ;;
      *) echo "wt done: unexpected arg '$1'" >&2; exit 1 ;;
    esac
  done

  local main_path=$main_repo
  if [[ "$repo_root" == "$main_path" ]]; then
    echo "wt done: already in main worktree, nothing to clean" >&2
    exit 1
  fi

  # cd out of the worktree before removing it, so the rest of this process
  # doesn't run from a deleted cwd.
  cd "$main_path"

  local args=()
  $force && args+=(--force)
  args+=("$repo_root")
  git worktree remove "${args[@]}" >&2

  echo "$main_path"
}

# ---------- main ----------

[[ $# -eq 0 ]] && { show_help; exit 0; }
case "$1" in
  -h|--help|help) show_help; exit 0 ;;
  --version) echo "wt $VERSION"; exit 0 ;;
esac

cmd=$1
case "$cmd" in
  list|ls|create|add|new|remove|rm|back|done)
    shift ;;
  *)
    cmd=create
    ;;
esac

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "wt: run inside a git repository" >&2
  exit 1
}

repo_root=$(git rev-parse --show-toplevel)
main_repo=$(main_worktree)
repo_name=$(basename "$main_repo")

case "$cmd" in
  list|ls)        cmd_list "$@" ;;
  create|add|new) cmd_create "$@" ;;
  remove|rm)      cmd_remove "$@" ;;
  back)           cmd_back ;;
  done)           cmd_done "$@" ;;
esac
